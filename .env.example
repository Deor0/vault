# Copy to .env (gitignored) and fill in. Never commit real credentials.

# Plaid API keys: https://dashboard.plaid.com/developers/keys
# Use the Sandbox secret while PLAID_ENV=sandbox, and the Production secret
# once you switch PLAID_ENV=production (Trial plan).
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (default) or production
PLAID_ENV=sandbox

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://vault:vault@localhost:5432/vault

# Auth.js: secret that encrypts the session cookie. 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
# Changing it signs everyone out.
# AUTH_SECRET (the name Auth.js reads natively) also works and wins if both are set.
BETTER_AUTH_SECRET=
# Trust the Host header when building Auth.js URLs. Needed for `npm start`
# (production mode) on 127.0.0.1; `npm run dev` trusts it automatically.
# If you ever put Vault behind a real domain, set AUTH_URL instead.
AUTH_TRUST_HOST=true

# Key that encrypts Plaid access tokens at rest: 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
# Changing it makes already-stored access tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Optional: OAuth redirect URI, only needed if you choose redirect-based OAuth.
# Web Link opens OAuth banks in a popup without it. If set, it must also be
# registered under Allowed redirect URIs in the Plaid Dashboard.
# PLAID_REDIRECT_URI=
